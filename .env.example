# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-real-environments
DEBUG=True
TIME_ZONE=America/Denver

# Host & CORS Configuration
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Database Configuration
# Leave DATABASE_URL unset for local SQLite fallback
# Docker Compose injects PostgreSQL connection settings automatically
# DATABASE_URL=postgresql://user:password@localhost/codepop
DB_CONN_MAX_AGE=60

# Celery Configuration
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=True
CELERY_TASK_TIME_LIMIT=300

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Payment Processing
PAYMENT_MODE=mock
PAYMENT_CHECKOUT_FLOW=hosted
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Geolocation & Maps
MAPBOX_PUBLIC_TOKEN=

# Push Notifications
FCM_SERVER_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Seed Data
SEED_USER_PASSWORD=CodePop123!

# AI Provider Selection
# Supported: deterministic, mock-external, anthropic
AI_RECOMMENDATION_PROVIDER=deterministic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
AI_PROVIDER_TIMEOUT_SECONDS=8
AI_PROVIDER_MAX_RETRIES=2
