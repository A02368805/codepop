# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=multi-dev-secret-key-change-me-in-production
DEBUG=True
TIME_ZONE=America/Denver

# Host & CORS Configuration
ALLOWED_HOSTS=127.0.0.1,localhost,web_a,web_b,web_c

# Database Configuration (per store, set in docker-compose.multi.yml)
DB_CONN_MAX_AGE=60

# Celery Configuration (shared Redis, async mode for distributed testing)
CELERY_TASK_TIME_LIMIT=300

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Payment Processing
PAYMENT_MODE=mock
PAYMENT_CHECKOUT_FLOW=hosted
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Geolocation & Maps
MAPBOX_PUBLIC_TOKEN=

# Push Notifications
FCM_SERVER_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Seed Data
SEED_USER_PASSWORD=CodePop123!

# AI Provider Selection
AI_RECOMMENDATION_PROVIDER=deterministic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
AI_PROVIDER_TIMEOUT_SECONDS=8
AI_PROVIDER_MAX_RETRIES=2

# Distributed Sync Configuration
SYNC_API_SECRET=multi-dev-secret-change-me-in-production
